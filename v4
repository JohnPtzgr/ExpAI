def load_mnist(batch_size=128):
    """Load and preprocess MNIST dataset."""
    (x_train, y_train), (x_test, y_test) = tf.keras.datasets.mnist.load_data()

    x_train = x_train.reshape(-1, 784).astype(np.float32)
    x_test = x_test.reshape(-1, 784).astype(np.float32)

    train_ds = tf.data.Dataset.from_tensor_slices((x_train, y_train))
    train_ds = train_ds.shuffle(10000).batch(batch_size).prefetch(tf.data.AUTOTUNE)

    test_ds = tf.data.Dataset.from_tensor_slices((x_test, y_test))
    test_ds = test_ds.batch(batch_size).prefetch(tf.data.AUTOTUNE)

    return train_ds, test_ds


def train_epoch(model, train_ds, optimizer, epoch):
    """Train for one epoch."""
    train_loss = tf.keras.metrics.Mean()
    train_acc = tf.keras.metrics.SparseCategoricalAccuracy()

    for batch_x, batch_y in train_ds:
        with tf.GradientTape() as tape:
            logits = model(batch_x, training=True)
            loss = tf.reduce_mean(
                tf.keras.losses.sparse_categorical_crossentropy(batch_y, logits, from_logits=True)
            )

        grads = tape.gradient(loss, model.trainable_variables)
        optimizer.apply_gradients(zip(grads, model.trainable_variables))

        # if updater is not None and batch_idx % updater.update_frequency == 0:
        #     updater.update(loss.numpy(), network)

        train_loss.update_state(loss)
        train_acc.update_state(batch_y, logits)

    return train_loss.result().numpy(), train_acc.result().numpy()


def evaluate(model, test_ds):
    """Evaluate model on test set."""
    test_acc = tf.keras.metrics.SparseCategoricalAccuracy()

    for batch_x, batch_y in test_ds:
        logits = model(batch_x, training=False)
        test_acc.update_state(batch_y, logits)

    return test_acc.result().numpy()


