class ValveNetwork(Model):
    """Complete network with probabilistic valve layers."""

    def __init__(
            self,
            input_dim: int,
            hidden_dims: List[int],
            num_classes: int,
            valve_bits: int = 4,
            initial_sparsity: float = 0.7,
            name: str = "valve_network"
    ):
        super().__init__(name=name)

        self.input_dim = input_dim
        self.hidden_dims = hidden_dims
        self.num_classes = num_classes
        self.valve_bits = valve_bits

        # Build valve layers
        self.layers_list = []
        prev_dim = input_dim

        for i, dim in enumerate(hidden_dims):
            layer = ProbabilisticValveLayer(
                units=dim,
                input_dim=prev_dim,
                valve_bits=valve_bits,
                initial_sparsity=initial_sparsity,
                name=f"valve_layer_{i}"
            )
            self.layers_list.append(layer)
            prev_dim = dim

        # Final classifier
        self.classifier = tf.keras.layers.Dense(num_classes, name="classifier")

    def call(self, inputs, training=None):
        x = tf.reshape(inputs, (-1, self.input_dim))
        x = (x - 0.5) * 2  # Normalize to [-1, 1]

        for layer in self.layers_list:
            x = layer(x, training=training)

        return self.classifier(x, training=training)

    def optimize_connections(self, train_ds, val_ds, epochs=5):
        """
        Initial connection optimization pass before training amplifiers.
        This uses the probabilistic valve update rule to find good initial connections.
        """
        print("\n" + "=" * 60)
        print("INITIAL CONNECTION OPTIMIZATION PASS")
        print("=" * 60)

        # Use a temporary optimizer for this phase
        temp_optimizer = tf.keras.optimizers.legacy.Adam(learning_rate=0.01)

        for epoch in range(epochs):
            train_loss = tf.keras.metrics.Mean()
            train_acc = tf.keras.metrics.SparseCategoricalAccuracy()

            for batch_x, batch_y in train_ds:
                with tf.GradientTape() as tape:
                    logits = self(batch_x, training=True)
                    loss = tf.reduce_mean(
                        tf.keras.losses.sparse_categorical_crossentropy(batch_y, logits, from_logits=True)
                    )

                # Only update amplifiers (valves are fixed but we want gradients for them)
                grads = tape.gradient(loss, self.trainable_variables)
                temp_optimizer.apply_gradients(zip(grads, self.trainable_variables))

                train_loss.update_state(loss)
                train_acc.update_state(batch_y, logits)

            # Validation
            val_acc = tf.keras.metrics.SparseCategoricalAccuracy()
            for batch_x, batch_y in val_ds:
                logits = self(batch_x, training=False)
                val_acc.update_state(batch_y, logits)

            print(
                f"  Connection Opt Epoch {epoch + 1}: Train Acc={train_acc.result().numpy():.4f}, Val Acc={val_acc.result().numpy():.4f}")

        print("Connection optimization complete.\n")

    def get_stats(self):
        print("\n" + "=" * 60)
        print("VALVE NETWORK STATISTICS")
        print("=" * 60)
        for i, layer in enumerate(self.layers_list):
            print(f"\nLayer {i}:")
            layer.get_valve_stats()
        print("=" * 60 + "\n")


