def main():
    print("=" * 70)
    print("VALVE NETWORK WITH PROBABILISTIC UPDATES")
    print("=" * 70)

    BATCH_SIZE = 128
    EPOCHS = 20
    LEARNING_RATE = 0.001
    VALVE_BITS = 4
    INITIAL_SPARSITY = 0.7  # 70% zeros initially

    print("\nLoading MNIST data...")
    train_ds, test_ds = load_mnist(batch_size=BATCH_SIZE)

    # Build network
    network = ValveNetwork(
        input_dim=784,
        hidden_dims=[256, 128, 64],
        num_classes=10,
        valve_bits=VALVE_BITS,
        initial_sparsity=INITIAL_SPARSITY
    )

    # Build the network (forward pass to create variables)
    dummy_input = tf.zeros((1, 784))
    _ = network(dummy_input, training=False)

    # Initial connection optimization pass
    network.optimize_connections(train_ds, test_ds, epochs=5)

    # Print network statistics after connection optimization
    network.get_stats()

    total_trainable = sum(np.prod(v.shape) for v in network.trainable_variables)
    print(f"Total trainable parameters: {total_trainable:,}")

    # Optimizer for main training
    optimizer = tf.keras.optimizers.legacy.Adam(learning_rate=LEARNING_RATE)

    print("\n" + "=" * 60)
    print("MAIN TRAINING PHASE (Amplifiers Only)")
    print("=" * 60)

    train_accs = []
    test_accs = []

    for epoch in range(1, EPOCHS + 1):
        train_loss, train_acc = train_epoch(network, train_ds, optimizer, epoch)
        test_acc = evaluate(network, test_ds)

        train_accs.append(train_acc)
        test_accs.append(test_acc)

        print(f"Epoch {epoch:2d}: Train Acc={train_acc:.4f}, Test Acc={test_acc:.4f}")

        if epoch % 5 == 0:
            network.get_stats()

    print("\n" + "=" * 60)
    print(f"Best Test Accuracy: {max(test_accs):.4f} ({max(test_accs) * 100:.2f}%)")
    print("=" * 60)

    network.get_stats()

    return network


if __name__ == "__main__":
    network = main()
